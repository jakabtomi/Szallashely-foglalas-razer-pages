@page
@model Szallashely_foglalas_razer_pages.Pages.Szobak.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Szoba[0].Szam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Szoba[0].Ferohely)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Szoba[0].EjszakaiAr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Szoba[0].Leiras)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Szoba) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Szam)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ferohely)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EjszakaiAr)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Leiras)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
